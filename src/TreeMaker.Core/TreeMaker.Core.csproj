<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared by every solver and the app: the tree, the problem, layout checks, polygons and closing, the crease pattern and symmetry breaking. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TreeMaker.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Google OR-Tools: GLOP and SCIP for closing the polygons and the strain LPs; the solvers use it too. -->
    <PackageReference Include="Google.OrTools" Version="9.*" />
  </ItemGroup>

</Project>
