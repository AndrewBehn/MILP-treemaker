<Project Sdk="Microsoft.NET.Sdk">

  <!-- Scalable MILP TreeMaker: continuous LPs (GLOP), CP-SAT repair and neighbourhood search, and a SCIP closing finish. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TreeMaker.Scalable</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TreeMaker.Core\TreeMaker.Core.csproj" />
    <!-- The base model, for its predicted size, reported beside every scalable result. -->
    <ProjectReference Include="..\TreeMaker.Pure\TreeMaker.Pure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TreeMaker.Scalable.Tests" />
  </ItemGroup>

</Project>
