<Project Sdk="Microsoft.NET.Sdk">

  <!-- The base model (Pure MILP TreeMaker, and Symmetry-Breaking MILP with ProblemSpec.SymmetryBreaking), solved with SCIP. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TreeMaker.Pure</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TreeMaker.Core\TreeMaker.Core.csproj" />
  </ItemGroup>

</Project>
